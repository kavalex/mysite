ENV=dev
ADDR=:8080
DATABASE_URL=data.db
BASE_URL=http://localhost:8080
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
HEADER_TIMEOUT=5s

# Trusted reverse proxies (CIDR/IP, comma-separated). Empty — do not trust XFF.
TRUSTED_PROXIES=

# TLS (optional). If set — the server runs over HTTPS.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Rate limit on /login (reloadable via SIGHUP)
LOGIN_RATE_PER_MIN=30
LOGIN_BURST=5
